<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>MIS Miftahul Falah | Madrasah Unggul, Islami dan Berprestasi</title>

    <meta name="description"
          content="Website resmi MIS Miftahul Falah. Madrasah Islami, berkarakter, berprestasi dan berwawasan masa depan.">

    <meta name="theme-color" content="#0b6b45">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: #263238;
            line-height: 1.6;
            background: #f7faf8;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        img {
            max-width: 100%;
            display: block;
        }

        /* =========================
           NAVBAR
        ========================== */

        .navbar {
            position: sticky;
            top: 0;
            z-index: 1000;
            background: rgba(255,255,255,0.96);
            box-shadow: 0 2px 15px rgba(0,0,0,0.08);
        }

        .nav-container {
            max-width: 1200px;
            margin: auto;
            padding: 12px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-logo {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #0b6b45;
        }

        .brand-text h1 {
            font-size: 18px;
            color: #075c3d;
        }

        .brand-text span {
            font-size: 12px;
            color: #777;
        }

        .nav-menu {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        .nav-menu a {
            font-size: 14px;
            font-weight: bold;
            color: #344;
            transition: 0.3s;
        }

        .nav-menu a:hover {
            color: #0b6b45;
        }

        .menu-button {
            display: none;
            border: none;
            background: #0b6b45;
            color: white;
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 20px;
            cursor: pointer;
        }

        /* =========================
           HERO
        ========================== */

        .hero {
            min-height: 620px;
            display: flex;
            align-items: center;
            position: relative;
            background:
                linear-gradient(
                    rgba(4,55,38,0.80),
                    rgba(4,55,38,0.75)
                ),
                url("https://images.unsplash.com/photo-1504052434569-70ad5836ab65?auto=format&fit=crop&w=1800&q=80")
                center/cover;
            color: white;
        }

        .hero-container {
            max-width: 1200px;
            width: 100%;
            margin: auto;
            padding: 80px 25px;
        }

        .hero-content {
            max-width: 750px;
        }

        .hero-badge {
            display: inline-block;
            background: rgba(255,255,255,0.15);
            border: 1px solid rgba(255,255,255,0.4);
            padding: 8px 16px;
            border-radius: 30px;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .hero h2 {
            font-size: 54px;
            line-height: 1.15;
            margin-bottom: 20px;
        }

        .hero h2 span {
            color: #f4c542;
        }

        .hero p {
            font-size: 18px;
            max-width: 680px;
            margin-bottom: 30px;
            color: #eaf6f0;
        }

        .buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 13px 22px;
            border-radius: 8px;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn-primary {
            background: #f4c542;
            color: #24300c;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            background: #ffd95e;
        }

        .btn-outline {
            border: 1px solid white;
            color: white;
        }

        .btn-outline:hover {
            background: white;
            color: #075c3d;
        }

        /* =========================
           GENERAL
        ========================== */

        .section {
            padding: 80px 25px;
        }

        .container {
            max-width: 1200px;
            margin: auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 45px;
        }

        .section-header span {
            color: #0b6b45;
            font-size: 14px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .section-header h2 {
            font-size: 36px;
            color: #173c2d;
            margin: 8px 0 12px;
        }

        .section-header p {
            max-width: 650px;
            margin: auto;
            color: #68747a;
        }

        /* =========================
           SAMBUTAN
        ========================== */

        .about-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
            align-items: center;
        }

        .about-image img {
            width: 100%;
            height: 420px;
            object-fit: cover;
            border-radius: 18px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.12);
        }

        .about-content h3 {
            font-size: 32px;
            color: #173c2d;
            margin-bottom: 18px;
        }

        .about-content p {
            color: #68747a;
            margin-bottom: 15px;
        }

        .quote {
            border-left: 4px solid #f4c542;
            padding-left: 18px;
            margin-top: 25px;
            font-style: italic;
            color: #455;
        }

        /* =========================
           STATISTIK
        ========================== */

        .stats {
            background: #0b6b45;
            color: white;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 25px;
            text-align: center;
        }

        .stat h3 {
            font-size: 40px;
            color: #f4c542;
        }

        .stat p {
            color: #e5f3ed;
        }

        /* =========================
           PROGRAM
        ========================== */

        .program-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 25px;
        }

        .card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.06);
            transition: 0.3s;
        }

        .card:hover {
            transform: translateY(-6px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.10);
        }

        .icon {
            width: 55px;
            height: 55px;
            border-radius: 12px;
            background: #e8f5ee;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 27px;
            margin-bottom: 18px;
        }

        .card h3 {
            margin-bottom: 10px;
            color: #173c2d;
        }

        .card p {
            color: #68747a;
            font-size: 14px;
        }

        /* =========================
           BERITA
        ========================== */

        .news-section {
            background: #eef6f1;
        }

        .news-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 25px;
        }

        .news-card {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.06);
        }

        .news-card img {
            width: 100%;
            height: 210px;
            object-fit: cover;
        }

        .news-body {
            padding: 22px;
        }

        .news-date {
            color: #0b6b45;
            font-size: 12px;
            font-weight: bold;
        }

        .news-body h3 {
            margin: 8px 0;
            color: #173c2d;
        }

        .news-body p {
            color: #68747a;
            font-size: 14px;
        }

        /* =========================
           GALERI
        ========================== */

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 15px;
        }

        .gallery-item {
            overflow: hidden;
            border-radius: 12px;
            height: 230px;
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: 0.4s;
        }

        .gallery-item:hover img {
            transform: scale(1.08);
        }

        /* =========================
           KONTAK
        ========================== */

        .contact {
            background: #173c2d;
            color: white;
        }

        .contact-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 50px;
        }

        .contact h2 {
            font-size: 35px;
            margin-bottom: 15px;
        }

        .contact p {
            color: #d9e9e1;
        }

        .contact-info {
            margin-top: 25px;
        }

        .contact-item {
            margin-bottom: 18px;
        }

        .contact-item strong {
            display: block;
            color: #f4c542;
            margin-bottom: 4px;
        }

        .contact-form {
            background: white;
            padding: 30px;
            border-radius: 15px;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 13px;
            margin-bottom: 15px;
            border: 1px solid #ddd;
            border-radius: 7px;
            font-family: inherit;
        }

        .contact-form textarea {
            height: 130px;
            resize: vertical;
        }

        /* =========================
           FOOTER
        ========================== */

        footer {
            background: #092f20;
            color: white;
            padding: 25px;
            text-align: center;
        }

        footer p {
            font-size: 13px;
            color: #bcd0c7;
        }

        /* =========================
           RESPONSIVE
        ========================== */

        @media (max-width: 900px) {

            .hero h2 {
                font-size: 42px;
            }

            .program-grid,
            .news-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .gallery-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .stats-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .about-grid,
            .contact-grid {
                grid-template-columns: 1fr;
            }

            .nav-menu {
                display: none;
                position: absolute;
                top: 76px;
                left: 0;
                right: 0;
                background: white;
                padding: 20px;
                flex-direction: column;
                box-shadow: 0 10px 20px rgba(0,0,0,0.08);
            }

            .nav-menu.active {
                display: flex;
            }

            .menu-button {
                display: block;
            }
        }

        @media (max-width: 600px) {

            .hero {
                min-height: 560px;
            }

            .hero h2 {
                font-size: 34px;
            }

            .hero p {
                font-size: 16px;
            }

            .section {
                padding: 60px 18px;
            }

            .section-header h2 {
                font-size: 29px;
            }

            .program-grid,
            .news-grid,
            .stats-grid,
            .gallery-grid {
                grid-template-columns: 1fr;
            }

            .gallery-item {
                height: 250px;
            }

            .brand-text h1 {
                font-size: 15px;
            }
        }
    </style>
</head>

